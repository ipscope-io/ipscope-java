<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.ipscope</groupId>
    <artifactId>ipscope-sdk</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>IPScope Java Server-Side SDK</name>
    <description>Official zero-dependency, type-safe Sync &amp; Async Java 17+ Server-Side SDK for the IPScope IP Intelligence Platform.</description>
    <url>https://ipscope.io/docs/sdks/java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/ipscope-io/ipscope-java</url>
        <connection>scm:git:git://github.com/ipscope-io/ipscope-java.git</connection>
        <developerConnection>scm:git:ssh://github.com:ipscope-io/ipscope-java.git</developerConnection>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/ipscope-io/ipscope-java</url>
        </repository>
    </distributionManagement>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- Zero external runtime dependencies: avoids Jackson/Gson classpath conflicts -->
    <dependencies/>
</project>
